<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="CeraWindow" parent="AdwApplicationWindow">
    <property name="title">Cera</property>
    <property name="default-width">1000</property>
    <property name="default-height">700</property>
    <!-- Breakpoints need a minimum size; 360 × 294 is the HIG's smallest. -->
    <property name="width-request">360</property>
    <property name="height-request">294</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 600sp</condition>
        <setter object="split_view" property="collapsed">True</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToastOverlay" id="toasts">
        <property name="child">
          <object class="AdwOverlaySplitView" id="split_view">
            <property name="sidebar">
              <object class="CeraSidebar" id="sidebar"/>
            </property>
            <property name="content">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="title-widget">
                      <object class="AdwWindowTitle" id="title"/>
                    </property>
                    <child type="start">
                      <object class="GtkToggleButton">
                        <property name="icon-name">sidebar-show-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Toggle sidebar</property>
                        <property name="action-name">win.show-sidebar</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Main menu</property>
                        <property name="primary">True</property>
                        <property name="menu-model">primary_menu</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkButton">
                        <property name="icon-name">view-grid-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Pages</property>
                        <property name="action-name">win.pages</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkButton">
                        <property name="icon-name">cera-page-add-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Add page after this one</property>
                        <property name="action-name">win.add-page</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="top">
                  <object class="AdwTabBar" id="tab_bar">
                    <property name="view">tab_view</property>
                    <property name="autohide">True</property>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkStack" id="stack">
                    <property name="transition-type">crossfade</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">welcome</property>
                        <property name="child">
                          <object class="AdwStatusPage">
                            <property name="icon-name">folder-symbolic</property>
                            <property name="title" translatable="yes">Open a vault</property>
                            <property name="description" translatable="yes">A vault is a folder of notes</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">24</property>
                                <property name="halign">center</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">center</property>
                                    <child>
                                      <object class="GtkButton">
                                        <property name="label" translatable="yes">_Open Folder…</property>
                                        <property name="use-underline">True</property>
                                        <property name="action-name">win.open-vault</property>
                                        <style>
                                          <class name="pill"/>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton">
                                        <property name="label" translatable="yes">_Create Vault…</property>
                                        <property name="use-underline">True</property>
                                        <property name="action-name">win.create-vault</property>
                                        <style>
                                          <class name="pill"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkListBox" id="recent_list">
                                    <property name="selection-mode">none</property>
                                    <property name="width-request">320</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">vault</property>
                        <property name="child">
                          <object class="AdwStatusPage" id="vault_page">
                            <property name="icon-name">cera-note-symbolic</property>
                            <property name="title" translatable="yes">No note open</property>
                            <property name="description" translatable="yes">Pick a note in the sidebar, or start a new one</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="spacing">12</property>
                                <property name="halign">center</property>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label" translatable="yes">_New Note</property>
                                    <property name="use-underline">True</property>
                                    <property name="action-name">win.new-note</property>
                                    <property name="action-target">""</property>
                                    <style>
                                      <class name="pill"/>
                                      <class name="suggested-action"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label" translatable="yes">_Import PDF…</property>
                                    <property name="use-underline">True</property>
                                    <property name="action-name">win.import-pdf</property>
                                    <property name="action-target">""</property>
                                    <style>
                                      <class name="pill"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">tabs</property>
                        <property name="child">
                          <object class="GtkOverlay" id="note_overlay">
                            <property name="child">
                              <object class="AdwTabView" id="tab_view"/>
                            </property>
                            <!-- Floating tool bar; swatch buttons are added in window code. -->
                            <child type="overlay">
                              <object class="GtkBox" id="toolbar">
                                <property name="halign">center</property>
                                <property name="valign">end</property>
                                <property name="margin-bottom">18</property>
                                <property name="spacing">6</property>
                                <style>
                                  <class name="toolbar-pill"/>
                                </style>
                                <child>
                                  <object class="AdwToggleGroup" id="tools">
                                    <property name="active-name">pen</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">pen</property>
                                        <property name="icon-name">cera-pen-symbolic</property>
                                        <property name="tooltip" translatable="yes">Pen (P)</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">highlighter</property>
                                        <property name="icon-name">cera-highlighter-symbolic</property>
                                        <property name="tooltip" translatable="yes">Highlighter (H)</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">eraser</property>
                                        <property name="icon-name">cera-eraser-symbolic</property>
                                        <property name="tooltip" translatable="yes">Eraser (E)</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name">lasso</property>
                                        <property name="icon-name">cera-lasso-symbolic</property>
                                        <property name="tooltip" translatable="yes">Lasso (L)</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator">
                                    <property name="orientation">vertical</property>
                                  </object>
                                </child>
                                <!-- Colour swatches are added in window code. -->
                                <child>
                                  <object class="GtkBox" id="swatch_box">
                                    <property name="spacing">6</property>
                                  </object>
                                </child>
                                <!-- Size slots, also added in window code. -->
                                <child>
                                  <object class="GtkSeparator" id="size_separator">
                                    <property name="orientation">vertical</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="size_box">
                                    <property name="spacing">6</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator">
                                    <property name="orientation">vertical</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="icon-name">edit-undo-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Undo</property>
                                    <property name="action-name">win.undo</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="icon-name">edit-redo-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Redo</property>
                                    <property name="action-name">win.redo</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Open File…</attribute>
        <attribute name="action">win.open</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Export as PDF…</attribute>
        <attribute name="action">win.export-pdf</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Export Page as P_NG…</attribute>
        <attribute name="action">win.export-png</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Cera</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
